# OS junk
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/

# misc
*.log
*.tmp
__pycache__/

# raw/unoptimized media & transfer archives (keep only web-optimized assets in git)
*.mov
*.zip
*.bundle

# internal hotel documents (rate sheets, room overviews - no publication permission): never commit
assets/Hotels/

# the hotel library: local paths, extracted text, the permission register and facts files never enter this public repo
library.local.json
.library/
*.facts.json
facts.json
facts/
*[Pp]ermission*.csv
*_EFE_*-Website-Facts_v*.md
*_EFE_*-Offer-Text_v*.md
*_EFE_*-Owner-Facts_v*.md

# the hotels skill belongs to the repo, even where a global ignore hides .claude/
!.claude/
.claude/*
!.claude/skills/

# the built site: scripts/build.py writes it, GitHub Actions deploys it
_site/

# local tooling
.venv/
.ruff_cache/
.pytest_cache/
uv.lock
missing*.json
